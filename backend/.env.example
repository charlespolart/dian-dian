DATABASE_URL=postgres://user:password@localhost:5432/dian_dian
JWT_SECRET=change-me-to-a-random-64-char-string
RESEND_API_KEY=re_xxxxxxxxxxxx
PORT=3001
CORS_ORIGIN=http://localhost:8081
APP_URL=http://localhost:3001
# RevenueCat webhook authorization header. Generate a random string and set
# the same value in the RC dashboard under Integrations → Webhooks.
REVENUECAT_WEBHOOK_SECRET=change-me-to-a-random-string
# Optional. App Store campaign "provider token" (App Store Connect → Analytics →
# Campaigns → Generate campaign link). When set, the landing's App Store button
# carries ?pt=…&ct=<utm_source> for visitors arriving with UTM params.
APPLE_CAMPAIGN_PT=
# Optional. The site's audience counter (src/audience).
# on / off (also true / false, 1 / 0); any other value keeps the default.
# `off`: do not read a known utm_source as the site of origin when there is no Referer.
# AUDIENCE_TAG_FALLBACK=off
# Download the robots' IP ranges and the country database (4 MB) at start.
# Default: on in production only (a dev server restarts at every save).
# AUDIENCE_DOWNLOADS=on
