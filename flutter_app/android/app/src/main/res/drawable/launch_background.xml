<?xml version="1.0" encoding="utf-8"?>
<!-- The launch window before Flutter's first frame: the app's cream and the
     title block of the Flutter loading screen (点点 / Dian Dian), centred like
     it, so the handover is invisible. Android 12+ shows the system splash
     (icon on the cream of values-v31) instead. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_image" />
    </item>
</layer-list>
